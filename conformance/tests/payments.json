      { "status": 200, "body": [ { "id": 1, "amount_cents": 5000, "currency": "CAD", "method": "cash" } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.id", "equals": 1 }
    }
  },
  {
    "name": "show_payment_success",
    "operation": "show_payment",
    "method": "GET",
