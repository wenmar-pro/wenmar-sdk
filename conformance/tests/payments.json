[
  {
    "name": "list_payments_success",
    "operation": "list_payments",
    "method": "GET",
    "path": "/payments",
    "query": { "method": "cash" },
    "mockResponses": [
      { "status": 200, "body": [ { "id": 1, "amount_cents": 5000, "currency": "CAD", "method": "cash" } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.amount_cents", "equals": 5000 }
    }
  },
  {
    "name": "list_payments_pending_success",
    "operation": "list_payments_pending",
    "method": "GET",
