      { "status": 200, "body": { "id": 1, "amount_cents": 5000, "currency": "CAD", "method": "cash", "processor_status": "succeeded" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "processor_status", "equals": "succeeded" }
    }
  },
