    "mockResponses": [
      { "status": 200, "body": { "id": 1, "name": "Updated Name", "slug": "main-shop", "billing_email": "billing@example.com", "url": "https://api.example.com/settings/account", "app_url": "https://app.example.com/settings/account" } }
    ],
