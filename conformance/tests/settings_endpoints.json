[
  {
    "name": "list_settings_account_success",
    "operation": "list_settings_account",
    "method": "GET",
    "path": "/settings/account",
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "name": "Main Shop", "slug": "main-shop", "billing_email": "billing@example.com", "url": "https://api.example.com/settings/account", "app_url": "https://app.example.com/settings/account" } }
    ],
    "expect": { "requestCount": 1, "noError": true, "responseBody": { "path": "name", "equals": "Main Shop" } }
  },
  {
    "name": "update_settings_account_success",
