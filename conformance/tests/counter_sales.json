[
  {
    "name": "list_counter_sales_success",
    "operation": "list_counter_sales",
    "method": "GET",
    "path": "/counter_sales",
    "mockResponses": [
      { "status": 200, "body": [ { "id": 1, "counter_sale_number": 1001, "status": "open", "total_cents": 2500 } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.counter_sale_number", "equals": 1001 }
    }
  },
  {
    "name": "show_counter_sale_success",
    "operation": "show_counter_sale",
    "method": "GET",
    "path": "/counter_sales/1",
    "pathParams": { "id": 1 },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "counter_sale_number": 1001, "status": "open", "total_cents": 2500 } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "status", "equals": "open" }
    }
  },
  {
    "name": "create_counter_sale_success",
    "operation": "create_counter_sale",
    "method": "POST",
    "path": "/counter_sales",
    "requestBody": { "counter_sale": { "walk_in_name": "Walk-in Customer" } },
    "mockResponses": [
      { "status": 201, "body": { "id": 1, "counter_sale_number": 1001, "status": "open", "walk_in_name": "Walk-in Customer" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "id", "equals": 1 }
    }
  },
  {
    "name": "update_counter_sale_success",
    "operation": "update_counter_sale",
    "method": "PATCH",
    "path": "/counter_sales/1",
    "pathParams": { "id": 1 },
    "requestBody": { "counter_sale": { "notes": "Paid in cash" } },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "counter_sale_number": 1001, "status": "open", "notes": "Paid in cash" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "notes", "equals": "Paid in cash" }
    }
  },
  {
    "name": "list_counter_sales_line_items_brands_success",
    "operation": "list_counter_sales_line_items_brands",
    "method": "GET",
    "path": "/counter_sales/1/line_items/brands",
    "pathParams": { "counter_sale_id": 1 },
    "mockResponses": [
      { "status": 200, "body": [ { "brand": "Acme" } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.brand", "equals": "Acme" }
    }
  }
]
