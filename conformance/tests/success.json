[
  {
    "name": "list_customers_success",
    "operation": "list_customers",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      { "status": 200, "body": [ { "id": 1, "full_name": "Jane Doe" } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.full_name", "equals": "Jane Doe" }
    }
  },
  {
    "name": "show_customer_success",
    "operation": "show_customer",
    "method": "GET",
    "path": "/customers/1",
    "pathParams": { "id": 1 },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "full_name": "Jane Doe" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "id", "equals": 1 }
    }
  },
  {
    "name": "create_customer_success",
    "operation": "create_customer",
    "method": "POST",
    "path": "/customers",
    "requestBody": { "customer": { "first_name": "Jane", "last_name": "Doe" } },
    "mockResponses": [
      { "status": 201, "body": { "id": 1, "full_name": "Jane Doe" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "full_name", "equals": "Jane Doe" }
    }
  },
  {
    "name": "show_vehicle_success",
    "operation": "show_vehicle",
    "method": "GET",
    "path": "/vehicles/1",
    "pathParams": { "id": 1 },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "make": "Toyota", "model": "Camry", "year": 2020, "vin": "ABC123" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "make", "equals": "Toyota" }
    }
  },
  {
    "name": "list_work_orders_success",
    "operation": "list_work_orders",
    "method": "GET",
    "path": "/work_orders",
    "mockResponses": [
      { "status": 200, "body": [ { "id": 1, "status": "open" } ] }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "0.status", "equals": "open" }
    }
  },
  {
    "name": "show_work_order_success",
    "operation": "show_work_order",
    "method": "GET",
    "path": "/work_orders/1",
    "pathParams": { "id": 1 },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "status": "open" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "status", "equals": "open" }
    }
  }
]
