[
  {
    "name": "404_on_missing_customer",
    "operation": "show_customer",
    "method": "GET",
    "path": "/customers/999999",
    "pathParams": { "id": 999999 },
    "mockResponses": [
      { "status": 404, "body": { "error": { "code": "not_found", "message": "Customer not found", "details": {} } } }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "not_found",
      "errorStatus": 404
    }
  },
  {
    "name": "401_unauthorized",
    "operation": "list_customers",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      { "status": 401, "body": { "error": { "code": "unauthorized", "message": "Invalid or missing API token", "details": {} } } }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "unauthorized",
      "errorStatus": 401
    }
  },
  {
    "name": "422_validation_failed",
    "operation": "create_vehicle",
    "method": "POST",
    "path": "/vehicles",
    "requestBody": { "vehicle": { "make": "", "model": "", "year": 0 } },
    "mockResponses": [
      {
        "status": 422,
        "body": { "error": { "code": "validation_failed", "message": "Make can't be blank", "details": { "make": ["can't be blank"] } } }
      }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "validation_failed",
      "errorStatus": 422
    }
  },
  {
    "name": "507_limit_exceeded",
    "operation": "list_customers",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      { "status": 507, "body": { "error": { "code": "limit_exceeded", "message": "Account limit reached", "details": {} } } }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "limit_exceeded",
      "errorStatus": 507
    }
  }
]
