[
  {
    "name": "merge_customer_success",
    "operation": "merge_customer",
    "method": "POST",
    "path": "/customers/1/merges",
    "pathParams": {
      "id": 1
    },
    "requestBody": {
      "source_customer_id": 2
    },
    "mockResponses": [
      {
        "status": 200,
        "body": {
          "id": 1,
          "full_name": "Jane Doe",
          "type": "Customer"
        }
      }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": {
        "path": "id",
        "equals": 1
      }
    }
  },
  {
    "name": "merge_customer_missing_source",
    "operation": "merge_customer",
    "method": "POST",
    "path": "/customers/1/merges",
    "pathParams": {
      "id": 1
    },
    "requestBody": {
      "source_customer_id": 999999
    },
    "mockResponses": [
      {
        "status": 422,
        "body": {
          "error": {
            "code": "validation_failed",
            "message": "Source customer not found."
          }
        }
      }
    ],
    "expect": {
      "requestCount": 1,
      "noError": false,
      "errorCode": "validation_failed",
      "errorStatus": 422
    }
  },
