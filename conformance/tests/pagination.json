[
  {
    "name": "paginate_through_customers",
    "operation": "list_customers_paginated",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      {
        "status": 200,
        "headers": { "Link": "<{server}/customers?page=2>; rel=\"next\"" },
        "body": [ { "id": 1, "full_name": "Jane Doe" } ]
      },
      {
        "status": 200,
        "body": [ { "id": 2, "full_name": "John Smith" } ]
      }
    ],
    "expect": {
      "requestCount": 2,
      "noError": true,
      "responseBody": { "path": "0.id", "equals": 2 }
    }
  },
  {
    "name": "paginate_work_orders",
    "operation": "list_work_orders_paginated",
    "method": "GET",
    "path": "/work_orders",
    "mockResponses": [
      {
        "status": 200,
        "headers": { "Link": "<{server}/work_orders?page=2>; rel=\"next\"" },
        "body": [ { "id": 1, "status": "open" } ]
      },
      {
        "status": 200,
        "body": [ { "id": 2, "status": "in_progress" } ]
      }
    ],
    "expect": {
      "requestCount": 2,
      "noError": true,
      "responseBody": { "path": "0.id", "equals": 2 }
    }
  },
  {
    "name": "paginate_rejects_cross_origin",
    "operation": "list_customers_paginated",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      {
        "status": 200,
        "headers": { "Link": "<https://attacker.example.com/customers?page=2>; rel=\"next\"" },
        "body": [ { "id": 1 } ]
      }
    ],
    "expect": {
      "requestCount": 1,
      "assertNoOutboundRequest": true,
      "errorCode": "invalid_pagination"
    }
  }
]
