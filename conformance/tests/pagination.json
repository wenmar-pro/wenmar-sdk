[
  {
    "name": "paginate_through_customers",
    "operation": "list_customers_paginated",
    "method": "GET",
    "path": "/api/customers",
    "mockResponses": [
      {
        "status": 200,
        "headers": { "Link": "<{server}/api/customers?page=2>; rel=\"next\"" },
        "body": { "data": [ { "id": 1, "full_name": "Jane Doe" } ] }
      },
      {
        "status": 200,
        "body": { "data": [ { "id": 2, "full_name": "John Smith" } ] }
      }
    ],
    "expect": {
      "requestCount": 2,
      "noError": true,
      "responseBody": { "path": "data.0.id", "equals": 2 }
    }
  },
  {
    "name": "paginate_work_orders",
    "operation": "list_work_orders_paginated",
    "method": "GET",
    "path": "/api/work_orders",
    "mockResponses": [
      {
        "status": 200,
        "headers": { "Link": "<{server}/api/work_orders?page=2>; rel=\"next\"" },
        "body": { "data": [ { "id": 1, "status": "open" } ] }
      },
      {
        "status": 200,
        "body": { "data": [ { "id": 2, "status": "in_progress" } ] }
      }
    ],
    "expect": {
      "requestCount": 2,
      "noError": true,
      "responseBody": { "path": "data.0.id", "equals": 2 }
    }
  }
]
