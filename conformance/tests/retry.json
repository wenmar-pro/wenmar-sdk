[
  {
    "name": "retry_on_500_then_200",
    "operation": "list_customers",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      {
        "status": 500,
        "body": { "error": { "code": "internal_error", "message": "Simulated failure", "field_errors": {} } }
      },
      {
        "status": 500,
        "body": { "error": { "code": "internal_error", "message": "Simulated failure", "field_errors": {} } }
      },
      {
        "status": 200,
        "body": [ { "id": 1, "full_name": "Jane Doe" } ]
      }
    ],
    "expect": {
      "requestCount": 3,
      "noError": true
    }
  },
  {
    "name": "retry_max_retries_exceeded",
    "operation": "list_customers",
    "method": "GET",
    "path": "/customers",
    "mockResponses": [
      { "status": 500, "body": { "error": { "code": "internal_error", "message": "fail", "field_errors": {} } } },
      { "status": 500, "body": { "error": { "code": "internal_error", "message": "fail", "field_errors": {} } } },
      { "status": 500, "body": { "error": { "code": "internal_error", "message": "fail", "field_errors": {} } } },
      { "status": 500, "body": { "error": { "code": "internal_error", "message": "fail", "field_errors": {} } } }
    ],
    "expect": {
      "requestCount": 4,
      "errorCode": "internal_error",
      "errorStatus": 500
    }
  },
  {
    "name": "no_retry_on_404",
    "operation": "show_customer",
    "method": "GET",
    "path": "/customers/999",
    "pathParams": { "id": 999 },
    "mockResponses": [
      { "status": 404, "body": { "error": { "code": "not_found", "message": "Customer not found", "field_errors": {} } } }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "not_found",
      "errorStatus": 404
    }
  },
  {
    "name": "retry_post_on_500_not_retried",
    "operation": "create_customer",
    "method": "POST",
    "path": "/customers",
    "requestBody": { "customer": { "first_name": "Test", "last_name": "User" } },
    "mockResponses": [
      { "status": 500, "body": { "error": { "code": "internal_error", "message": "fail", "field_errors": {} } } }
    ],
    "expect": {
      "requestCount": 1,
      "errorCode": "internal_error",
      "errorStatus": 500
    }
  },
  {
    "name": "retry_post_on_429_retried",
    "operation": "create_customer",
    "method": "POST",
    "path": "/customers",
    "requestBody": { "customer": { "first_name": "Test", "last_name": "User" } },
    "mockResponses": [
      { "status": 429, "headers": { "Retry-After": "0" }, "body": { "error": { "code": "rate_limited", "message": "slow", "field_errors": {} } } },
      { "status": 201, "body": { "id": 1 } }
    ],
    "expect": {
      "requestCount": 2,
      "noError": true
    }
  }
]
