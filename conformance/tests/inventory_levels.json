[
  {
    "name": "show_inventory_level_success",
    "operation": "show_inventory_level",
    "method": "GET",
    "path": "/inventory_levels/1",
    "pathParams": { "id": 1 },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "part_number": "BRK-001", "description": "Brake Pad Set", "stocked": true, "on_hand": 12 } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "on_hand", "equals": 12 }
    }
  },
  {
    "name": "update_inventory_level_success",
    "operation": "update_inventory_level",
    "method": "PATCH",
    "path": "/inventory_levels/1",
    "pathParams": { "id": 1 },
    "requestBody": { "part": { "description": "Brake Pad Set Premium" } },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "part_number": "BRK-001", "description": "Brake Pad Set Premium", "stocked": true } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "description", "equals": "Brake Pad Set Premium" }
    }
  },
  {
    "name": "list_inventory_levels_barcode_lookup_success",
    "operation": "list_inventory_levels_barcode_lookup",
    "method": "GET",
    "path": "/inventory_levels/barcode_lookup",
    "query": { "barcode": "1234567890123" },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "part_number": "BRK-001", "barcode": "1234567890123" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "barcode", "equals": "1234567890123" }
    }
  },
  {
    "name": "create_inventory_levels_adjust_success",
    "operation": "create_inventory_levels_adjust",
    "method": "POST",
    "path": "/inventory_levels/1/adjust",
    "pathParams": { "id": 1 },
    "requestBody": { "adjustment": { "on_hand": 15 } },
    "mockResponses": [
      { "status": 200, "body": { "id": 1, "part_number": "BRK-001", "stocked": true, "on_hand": 15 } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "on_hand", "equals": 15 }
    }
  },
  {
    "name": "create_inventory_level_extraction_success",
    "operation": "create_inventory_level_extraction",
    "method": "POST",
    "path": "/inventory_levels/extractions",
    "requestBody": { "text": "Bosch wiper blade 19in x2", "extraction_id": "ext-123" },
    "mockResponses": [
      { "status": 202, "body": { "status": "extraction_queued", "stream_id": "extraction:ext-123" } }
    ],
    "expect": {
      "requestCount": 1,
      "noError": true,
      "responseBody": { "path": "status", "equals": "extraction_queued" }
    }
  }
]
